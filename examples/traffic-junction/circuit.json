{
  "version": 1,
  "name": "Four-phase traffic junction",
  "exampleId": "traffic-junction",
  "nodes": [
    {
      "id": "clock",
      "type": "clock",
      "x": 20,
      "y": 20,
      "label": "Phase clock · 0.1 Hz",
      "enabled": true,
      "params": {
        "frequency": 0.1,
        "duty": 0.5
      }
    },
    {
      "id": "run",
      "type": "switch",
      "x": 20,
      "y": 230,
      "label": "Scene run",
      "enabled": true,
      "params": {
        "value": 1
      }
    },
    {
      "id": "reset",
      "type": "switch",
      "x": 20,
      "y": 440,
      "label": "Reset junction",
      "enabled": true,
      "params": {
        "value": 0
      }
    },
    {
      "id": "unsafe",
      "type": "switch",
      "x": 20,
      "y": 650,
      "label": "Unsafe east/west override",
      "enabled": true,
      "params": {
        "value": 0
      }
    },
    {
      "id": "phase",
      "type": "counter",
      "x": 300,
      "y": 100,
      "label": "Phase counter",
      "enabled": true,
      "params": {
        "initial": 0
      }
    },
    {
      "id": "bits",
      "type": "splitter",
      "x": 560,
      "y": 80,
      "label": "Phase bits",
      "enabled": true,
      "params": {}
    },
    {
      "id": "not0",
      "type": "not",
      "x": 820,
      "y": 20,
      "label": "NOT bit 0",
      "enabled": true,
      "params": {}
    },
    {
      "id": "not1",
      "type": "not",
      "x": 820,
      "y": 190,
      "label": "NOT bit 1",
      "enabled": true,
      "params": {}
    },
    {
      "id": "ns-green",
      "type": "and",
      "x": 1080,
      "y": 20,
      "label": "Phase 00 · NS green",
      "enabled": true,
      "params": {}
    },
    {
      "id": "ns-yellow",
      "type": "and",
      "x": 1080,
      "y": 210,
      "label": "Phase 01 · NS amber",
      "enabled": true,
      "params": {}
    },
    {
      "id": "ew-green",
      "type": "and",
      "x": 1080,
      "y": 400,
      "label": "Phase 10 · EW green",
      "enabled": true,
      "params": {}
    },
    {
      "id": "ew-yellow",
      "type": "and",
      "x": 1080,
      "y": 590,
      "label": "Phase 11 · EW amber",
      "enabled": true,
      "params": {}
    },
    {
      "id": "override",
      "type": "or",
      "x": 1340,
      "y": 400,
      "label": "EW green OR unsafe",
      "enabled": true,
      "params": {}
    },
    {
      "id": "junction",
      "type": "traffic_junction",
      "x": 1620,
      "y": 230,
      "label": "Crossroad",
      "enabled": true,
      "params": {
        "carSpeed": 12,
        "arrivalInterval": 4,
        "initialCars": 2
      }
    },
    {
      "id": "crash",
      "type": "led",
      "x": 1900,
      "y": 230,
      "label": "Collision latched",
      "enabled": true,
      "params": {}
    }
  ],
  "wires": [
    {
      "id": "clock-out-phase-clk",
      "from": {
        "node": "clock",
        "port": "out"
      },
      "to": {
        "node": "phase",
        "port": "clk"
      },
      "width": 1
    },
    {
      "id": "run-out-phase-enable",
      "from": {
        "node": "run",
        "port": "out"
      },
      "to": {
        "node": "phase",
        "port": "enable"
      },
      "width": 1
    },
    {
      "id": "reset-out-phase-reset",
      "from": {
        "node": "reset",
        "port": "out"
      },
      "to": {
        "node": "phase",
        "port": "reset"
      },
      "width": 1
    },
    {
      "id": "phase-out-bits-in",
      "from": {
        "node": "phase",
        "port": "out"
      },
      "to": {
        "node": "bits",
        "port": "in"
      },
      "width": 8
    },
    {
      "id": "bits-b0-not0-a",
      "from": {
        "node": "bits",
        "port": "b0"
      },
      "to": {
        "node": "not0",
        "port": "a"
      },
      "width": 1
    },
    {
      "id": "bits-b1-not1-a",
      "from": {
        "node": "bits",
        "port": "b1"
      },
      "to": {
        "node": "not1",
        "port": "a"
      },
      "width": 1
    },
    {
      "id": "not0-out-ns-green-a",
      "from": {
        "node": "not0",
        "port": "out"
      },
      "to": {
        "node": "ns-green",
        "port": "a"
      },
      "width": 1
    },
    {
      "id": "not1-out-ns-green-b",
      "from": {
        "node": "not1",
        "port": "out"
      },
      "to": {
        "node": "ns-green",
        "port": "b"
      },
      "width": 1
    },
    {
      "id": "bits-b0-ns-yellow-a",
      "from": {
        "node": "bits",
        "port": "b0"
      },
      "to": {
        "node": "ns-yellow",
        "port": "a"
      },
      "width": 1
    },
    {
      "id": "not1-out-ns-yellow-b",
      "from": {
        "node": "not1",
        "port": "out"
      },
      "to": {
        "node": "ns-yellow",
        "port": "b"
      },
      "width": 1
    },
    {
      "id": "not0-out-ew-green-a",
      "from": {
        "node": "not0",
        "port": "out"
      },
      "to": {
        "node": "ew-green",
        "port": "a"
      },
      "width": 1
    },
    {
      "id": "bits-b1-ew-green-b",
      "from": {
        "node": "bits",
        "port": "b1"
      },
      "to": {
        "node": "ew-green",
        "port": "b"
      },
      "width": 1
    },
    {
      "id": "bits-b0-ew-yellow-a",
      "from": {
        "node": "bits",
        "port": "b0"
      },
      "to": {
        "node": "ew-yellow",
        "port": "a"
      },
      "width": 1
    },
    {
      "id": "bits-b1-ew-yellow-b",
      "from": {
        "node": "bits",
        "port": "b1"
      },
      "to": {
        "node": "ew-yellow",
        "port": "b"
      },
      "width": 1
    },
    {
      "id": "ew-green-out-override-a",
      "from": {
        "node": "ew-green",
        "port": "out"
      },
      "to": {
        "node": "override",
        "port": "a"
      },
      "width": 1
    },
    {
      "id": "unsafe-out-override-b",
      "from": {
        "node": "unsafe",
        "port": "out"
      },
      "to": {
        "node": "override",
        "port": "b"
      },
      "width": 1
    },
    {
      "id": "ns-green-out-junction-ns_green",
      "from": {
        "node": "ns-green",
        "port": "out"
      },
      "to": {
        "node": "junction",
        "port": "ns_green"
      },
      "width": 1
    },
    {
      "id": "ns-yellow-out-junction-ns_yellow",
      "from": {
        "node": "ns-yellow",
        "port": "out"
      },
      "to": {
        "node": "junction",
        "port": "ns_yellow"
      },
      "width": 1
    },
    {
      "id": "override-out-junction-ew_green",
      "from": {
        "node": "override",
        "port": "out"
      },
      "to": {
        "node": "junction",
        "port": "ew_green"
      },
      "width": 1
    },
    {
      "id": "ew-yellow-out-junction-ew_yellow",
      "from": {
        "node": "ew-yellow",
        "port": "out"
      },
      "to": {
        "node": "junction",
        "port": "ew_yellow"
      },
      "width": 1
    },
    {
      "id": "run-out-junction-run",
      "from": {
        "node": "run",
        "port": "out"
      },
      "to": {
        "node": "junction",
        "port": "run"
      },
      "width": 1
    },
    {
      "id": "reset-out-junction-reset",
      "from": {
        "node": "reset",
        "port": "out"
      },
      "to": {
        "node": "junction",
        "port": "reset"
      },
      "width": 1
    },
    {
      "id": "junction-crash-crash-in",
      "from": {
        "node": "junction",
        "port": "crash"
      },
      "to": {
        "node": "crash",
        "port": "in"
      },
      "width": 1
    }
  ]
}
