      "x": 20,
      "y": 780,
      "enabled": true,
      "params": {
        "value": 0
      }
    },
    {
      "id": "gate",
      "type": "and",
      "label": "Motion AND authorized visitor",
      "x": 650,
      "y": 20,
      "enabled": true,
      "params": {}
    },
    {
      "id": "armed",
      "type": "not",
      "label": "Arm for unauthorized visitors",
      "x": 650,
      "y": 225,
      "enabled": true,
      "params": {}
    },
    {
      "id": "light",
      "type": "and",
      "label": "Dark AND motion",
      "x": 650,
      "y": 430,
      "enabled": true,
      "params": {}
    },
    {
      "id": "dry-weather",
      "type": "not",
      "label": "No rain",
      "x": 650,
      "y": 635,
      "enabled": true,
      "params": {}
    },
    {
      "id": "water-available",
      "type": "not",
      "label": "Tank not low",
      "x": 940,
      "y": 20,
      "enabled": true,
      "params": {}
    },
    {
      "id": "weather-safe",
      "type": "and",
      "label": "Dry weather AND water available",
      "x": 940,
      "y": 225,
      "enabled": true,
      "params": {}
    },
    {
      "id": "water",
      "type": "and",
      "label": "Weather-safe AND irrigation permitted",
      "x": 940,
      "y": 430,
      "enabled": true,
      "params": {}
    },
    {
      "id": "pump",
      "type": "or",
      "label": "Guarded irrigation OR unsafe bypass",
      "x": 940,
      "y": 635,
      "enabled": true,
      "params": {}
    },
    {
      "id": "alarm",
