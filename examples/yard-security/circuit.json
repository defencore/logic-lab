{
  "version": 1,
  "name": "Smart yard: access, rain and water",
  "exampleId": "yard-security",
  "nodes": [
    {
      "id": "run",
      "type": "switch",
      "label": "Scene run",
      "x": 20,
      "y": 20,
      "enabled": true,
      "params": {
        "value": 1
      }
    },
    {
      "id": "reset",
      "type": "switch",
      "label": "Reset process",
      "x": 20,
      "y": 210,
      "enabled": true,
      "params": {
        "value": 0
      }
    },
    {
      "id": "world",
      "type": "smart_home",
      "label": "Yard access and rain interlocks",
      "x": 320,
      "y": 60,
      "enabled": true,
      "params": {
        "initialTemperature": 20,
        "ambientTemperature": 12,
        "initialWater": 70,
        "dayLength": 60
      }
    },
    {
      "id": "authorized",
      "type": "switch",
      "label": "Visitor authorized",
      "x": 20,
      "y": 400,
      "enabled": true,
      "params": {
        "value": 1
      }
    },
    {
      "id": "water-permit",
