{
  "version": 1,
  "name": "Aquarium: timed portions",
  "exampleId": "aquarium-feeding",
  "nodes": [
    {
      "id": "run",
      "type": "switch",
      "label": "Scene run",
      "x": 20,
      "y": 20,
      "enabled": true,
      "params": {
        "value": 1
      }
    },
    {
      "id": "reset",
      "type": "switch",
      "label": "Reset process",
      "x": 20,
      "y": 210,
      "enabled": true,
      "params": {
        "value": 0
      }
    },
    {
      "id": "world",
      "type": "aquarium",
      "label": "Aquarium pulse feeding",
      "x": 320,
      "y": 60,
      "enabled": true,
      "params": {
        "initialTemperature": 24,
        "ambientTemperature": 18,
        "initialOxygen": 70,
        "initialFood": 45,
        "initialCleanliness": 80,
        "fishCount": 4,
        "dayLength": 60
      }
    },
    {
      "id": "force-feed",
      "type": "switch",
      "label": "Unsafe continuous feeding",
      "x": 20,
      "y": 400,
      "enabled": true,
      "params": {
        "value": 0
      }
    },
    {
      "id": "meal-clock",
      "type": "clock",
      "label": "Meal clock · every 4 seconds",
      "x": 650,
      "y": 20,
      "enabled": true,
      "params": {
        "frequency": 0.25,
        "duty": 0.1
      }
    },
    {
      "id": "portion",
      "type": "monostable",
      "label": "One-second portion",
      "x": 650,
      "y": 225,
      "enabled": true,
      "params": {
        "duration": 1
      }
    },
    {
      "id": "hungry-portion",
      "type": "and",
      "label": "Hungry AND portion pulse",
      "x": 650,
      "y": 430,
      "enabled": true,
      "params": {}
    },
    {
      "id": "feed",
      "type": "or",
      "label": "Guarded portion OR unsafe feed",
      "x": 650,
      "y": 635,
      "enabled": true,
      "params": {}
    },
    {
      "id": "alarm",
      "type": "led",
      "label": "Process alarm",
      "x": 1800,
      "y": 120,
      "enabled": true,
      "params": {}
    }
