      "type": "led",
      "x": 740,
      "y": 140,
      "label": "Sum",
      "enabled": true,
      "params": {}
    },
    {
      "id": "carry-led",
      "type": "led",
      "x": 740,
      "y": 360,
      "label": "Carry",
      "enabled": true,
      "params": {}
    }
  ],
  "wires": [
