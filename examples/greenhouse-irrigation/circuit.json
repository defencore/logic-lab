{
  "version": 1,
  "name": "Greenhouse: irrigation with memory",
  "exampleId": "greenhouse-irrigation",
  "nodes": [
    {
      "id": "run",
      "type": "switch",
      "label": "Scene run",
      "x": 20,
      "y": 20,
      "enabled": true,
      "params": {
        "value": 1
      }
    },
    {
      "id": "reset",
      "type": "switch",
      "label": "Reset process",
      "x": 20,
      "y": 210,
      "enabled": true,
      "params": {
        "value": 0
      }
    },
    {
      "id": "world",
      "type": "greenhouse",
      "label": "Greenhouse irrigation memory",
      "x": 320,
      "y": 60,
      "enabled": true,
      "params": {
        "initialTemperature": 20,
        "ambientTemperature": 12,
        "initialMoisture": 45,
        "dayLength": 60
      }
    },
    {
      "id": "force-pump",
      "type": "switch",
      "label": "Unsafe pump always on",
      "x": 20,
      "y": 400,
      "enabled": true,
      "params": {
        "value": 0
      }
    },
    {
      "id": "not-reset",
      "type": "not",
      "label": "Reset inactive",
      "x": 650,
      "y": 20,
      "enabled": true,
      "params": {}
    },
    {
      "id": "start",
      "type": "and",
      "label": "Dry AND not reset",
      "x": 650,
      "y": 225,
      "enabled": true,
      "params": {}
    },
    {
      "id": "stop",
      "type": "or",
      "label": "Wet OR reset",
      "x": 650,
      "y": 430,
      "enabled": true,
      "params": {}
    },
    {
      "id": "memory",
      "type": "sr_latch",
      "label": "Remember irrigation cycle",
      "x": 650,
      "y": 635,
      "enabled": true,
      "params": {
        "initial": 0
      }
    },
    {
      "id": "pump",
      "type": "or",
      "label": "Remembered cycle OR unsafe pump",
      "x": 940,
      "y": 20,
      "enabled": true,
      "params": {}
    },
    {
      "id": "alarm",
      "type": "led",
      "label": "Process alarm",
      "x": 1800,
      "y": 120,
      "enabled": true,
      "params": {}
    }
  ],
  "wires": [
    {
      "id": "run-out-world-run",
      "from": {
        "node": "run",
        "port": "out"
      },
      "to": {
        "node": "world",
        "port": "run"
      },
      "width": 1
    },
    {
      "id": "reset-out-world-reset",
      "from": {
        "node": "reset",
        "port": "out"
      },
      "to": {
        "node": "world",
        "port": "reset"
      },
      "width": 1
    },
    {
      "id": "world-cold-world-heater",
      "from": {
        "node": "world",
        "port": "cold"
      },
      "to": {
        "node": "world",
        "port": "heater"
      },
      "width": 1
    },
    {
      "id": "world-hot-world-vent",
      "from": {
        "node": "world",
        "port": "hot"
      },
      "to": {
        "node": "world",
        "port": "vent"
      },
      "width": 1
    },
    {
      "id": "world-dark-world-grow_light",
      "from": {
        "node": "world",
        "port": "dark"
      },
      "to": {
        "node": "world",
        "port": "grow_light"
      },
      "width": 1
    },
    {
      "id": "reset-out-not-reset-a",
      "from": {
        "node": "reset",
        "port": "out"
      },
      "to": {
        "node": "not-reset",
        "port": "a"
      },
      "width": 1
    },
    {
      "id": "world-dry-start-a",
      "from": {
        "node": "world",
        "port": "dry"
      },
      "to": {
        "node": "start",
        "port": "a"
      },
      "width": 1
    },
    {
      "id": "not-reset-out-start-b",
      "from": {
        "node": "not-reset",
        "port": "out"
      },
      "to": {
        "node": "start",
        "port": "b"
      },
      "width": 1
    },
    {
      "id": "world-wet-stop-a",
      "from": {
        "node": "world",
        "port": "wet"
      },
      "to": {
        "node": "stop",
        "port": "a"
      },
      "width": 1
    },
    {
      "id": "reset-out-stop-b",
      "from": {
        "node": "reset",
        "port": "out"
      },
      "to": {
        "node": "stop",
        "port": "b"
      },
      "width": 1
    },
    {
      "id": "start-out-memory-s",
      "from": {
        "node": "start",
        "port": "out"
      },
      "to": {
        "node": "memory",
        "port": "s"
      },
      "width": 1
    },
    {
      "id": "stop-out-memory-r",
      "from": {
        "node": "stop",
        "port": "out"
      },
      "to": {
        "node": "memory",
        "port": "r"
      },
      "width": 1
    },
    {
      "id": "memory-q-pump-a",
      "from": {
        "node": "memory",
        "port": "q"
      },
      "to": {
        "node": "pump",
        "port": "a"
      },
      "width": 1
    },
    {
      "id": "force-pump-out-pump-b",
      "from": {
        "node": "force-pump",
        "port": "out"
      },
      "to": {
        "node": "pump",
        "port": "b"
      },
      "width": 1
    },
    {
      "id": "pump-out-world-pump",
      "from": {
        "node": "pump",
        "port": "out"
      },
      "to": {
        "node": "world",
        "port": "pump"
      },
      "width": 1
    },
    {
      "id": "world-alarm-alarm-in",
      "from": {
        "node": "world",
        "port": "alarm"
      },
      "to": {
        "node": "alarm",
        "port": "in"
      },
      "width": 1
    }
  ]
}
