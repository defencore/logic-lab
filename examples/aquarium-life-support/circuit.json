{
  "version": 1,
  "name": "Aquarium: life-support interlocks",
  "exampleId": "aquarium-life-support",
  "nodes": [
    {
      "id": "run",
      "type": "switch",
      "label": "Scene run",
      "x": 20,
      "y": 20,
      "enabled": true,
      "params": {
        "value": 1
      }
    },
    {
      "id": "reset",
      "type": "switch",
      "label": "Reset process",
      "x": 20,
      "y": 210,
      "enabled": true,
      "params": {
        "value": 0
      }
    },
    {
      "id": "world",
      "type": "aquarium",
      "label": "Aquarium life support",
      "x": 320,
      "y": 60,
      "enabled": true,
      "params": {
        "initialTemperature": 24,
        "ambientTemperature": 18,
        "initialOxygen": 70,
        "initialFood": 45,
        "initialCleanliness": 80,
        "fishCount": 4,
        "dayLength": 60
      }
    },
    {
      "id": "unsafe-heat",
      "type": "switch",
      "label": "Unsafe stuck heater",
      "x": 20,
      "y": 400,
      "enabled": true,
      "params": {
        "value": 0
      }
    },
    {
      "id": "air-permit",
      "type": "switch",
      "label": "Air pump permitted",
      "x": 20,
      "y": 590,
      "enabled": true,
      "params": {
        "value": 1
      }
    },
    {
      "id": "heat",
      "type": "or",
      "label": "Cold OR stuck heater",
      "x": 650,
      "y": 20,
      "enabled": true,
      "params": {}
    },
    {
      "id": "heat-ok",
      "type": "not",
      "label": "No heater fault",
      "x": 650,
      "y": 225,
      "enabled": true,
      "params": {}
    },
    {
      "id": "cool",
      "type": "and",
      "label": "Hot AND cooling available",
      "x": 650,
      "y": 430,
      "enabled": true,
      "params": {}
    },
    {
      "id": "air",
      "type": "and",
      "label": "Low oxygen AND pump permitted",
      "x": 650,
      "y": 635,
      "enabled": true,
      "params": {}
    },
    {
      "id": "alarm",
      "type": "led",
      "label": "Process alarm",
      "x": 1800,
      "y": 120,
      "enabled": true,
      "params": {}
    }
