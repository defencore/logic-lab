        "node": "schmitt",
        "port": "out"
      },
      "to": {
        "node": "clean",
        "port": "in"
      },
      "width": 1
    },
    {
      "id": "dac-out-voltage-in",
      "from": {
        "node": "dac",
        "port": "out"
      },
      "to": {
        "node": "voltage",
        "port": "in"
