{
  "version": 1,
  "name": "Smart home: comfort and energy",
  "exampleId": "home-climate",
  "nodes": [
    {
      "id": "run",
      "type": "switch",
      "label": "Scene run",
      "x": 20,
      "y": 20,
      "enabled": true,
      "params": {
        "value": 1
      }
    },
    {
      "id": "reset",
      "type": "switch",
      "label": "Reset process",
      "x": 20,
      "y": 210,
      "enabled": true,
      "params": {
        "value": 0
      }
    },
    {
      "id": "world",
      "type": "smart_home",
      "label": "Home climate and energy",
      "x": 320,
      "y": 60,
      "enabled": true,
      "params": {
        "initialTemperature": 20,
        "ambientTemperature": 12,
        "initialWater": 70,
        "dayLength": 60
      }
    },
    {
      "id": "comfort",
      "type": "switch",
      "label": "Climate enabled",
      "x": 20,
      "y": 400,
      "enabled": true,
      "params": {
        "value": 1
      }
    },
    {
      "id": "force-lights",
      "type": "switch",
      "label": "Manual all lights",
      "x": 20,
      "y": 590,
      "enabled": true,
      "params": {
        "value": 0
      }
    },
    {
      "id": "heat",
      "type": "and",
      "label": "Cold AND climate enabled",
      "x": 650,
      "y": 20,
      "enabled": true,
      "params": {}
    },
    {
      "id": "fan",
      "type": "and",
      "label": "Hot AND climate enabled",
      "x": 650,
      "y": 225,
      "enabled": true,
      "params": {}
    },
    {
      "id": "lights",
      "type": "or",
      "label": "Dark OR manual lights",
      "x": 650,
      "y": 430,
      "enabled": true,
      "params": {}
    },
    {
      "id": "path",
      "type": "and",
      "label": "Dark AND motion",
      "x": 650,
      "y": 635,
      "enabled": true,
      "params": {}
    },
    {
      "id": "alarm",
      "type": "led",
      "label": "Process alarm",
      "x": 1800,
      "y": 120,
      "enabled": true,
      "params": {}
    }
  ],
  "wires": [
    {
      "id": "run-out-world-run",
      "from": {
        "node": "run",
        "port": "out"
      },
      "to": {
        "node": "world",
        "port": "run"
      },
      "width": 1
    },
    {
      "id": "reset-out-world-reset",
      "from": {
        "node": "reset",
        "port": "out"
      },
      "to": {
        "node": "world",
        "port": "reset"
      },
      "width": 1
    },
    {
      "id": "world-cold-heat-a",
      "from": {
        "node": "world",
        "port": "cold"
      },
      "to": {
        "node": "heat",
        "port": "a"
      },
      "width": 1
    },
    {
      "id": "comfort-out-heat-b",
      "from": {
        "node": "comfort",
        "port": "out"
      },
      "to": {
        "node": "heat",
        "port": "b"
      },
      "width": 1
    },
    {
      "id": "heat-out-world-heater",
      "from": {
        "node": "heat",
        "port": "out"
      },
      "to": {
        "node": "world",
        "port": "heater"
      },
      "width": 1
    },
    {
      "id": "world-hot-fan-a",
      "from": {
        "node": "world",
        "port": "hot"
      },
      "to": {
        "node": "fan",
        "port": "a"
      },
      "width": 1
    },
    {
      "id": "comfort-out-fan-b",
      "from": {
        "node": "comfort",
        "port": "out"
      },
      "to": {
        "node": "fan",
        "port": "b"
      },
      "width": 1
    },
    {
      "id": "fan-out-world-fan",
      "from": {
        "node": "fan",
        "port": "out"
      },
      "to": {
        "node": "world",
        "port": "fan"
      },
      "width": 1
    },
    {
      "id": "world-dark-lights-a",
      "from": {
        "node": "world",
        "port": "dark"
      },
      "to": {
        "node": "lights",
        "port": "a"
      },
      "width": 1
    },
    {
      "id": "force-lights-out-lights-b",
      "from": {
        "node": "force-lights",
        "port": "out"
      },
      "to": {
        "node": "lights",
        "port": "b"
      },
      "width": 1
    },
    {
      "id": "lights-out-world-indoor_light",
      "from": {
        "node": "lights",
        "port": "out"
      },
      "to": {
        "node": "world",
        "port": "indoor_light"
      },
      "width": 1
    },
    {
      "id": "world-dark-path-a",
      "from": {
        "node": "world",
        "port": "dark"
      },
      "to": {
        "node": "path",
        "port": "a"
      },
      "width": 1
    },
    {
      "id": "world-motion-path-b",
      "from": {
        "node": "world",
        "port": "motion"
      },
      "to": {
        "node": "path",
        "port": "b"
      },
      "width": 1
    },
    {
      "id": "path-out-world-outdoor_light",
      "from": {
        "node": "path",
        "port": "out"
      },
      "to": {
        "node": "world",
        "port": "outdoor_light"
      },
      "width": 1
    },
    {
      "id": "world-alarm-alarm-in",
      "from": {
        "node": "world",
        "port": "alarm"
      },
      "to": {
        "node": "alarm",
        "port": "in"
      },
      "width": 1
    }
  ]
}
