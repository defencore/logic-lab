{
  "version": 1,
  "name": "Feedback animal feeder",
  "exampleId": "animal-feeder",
  "nodes": [
    {
      "id": "run",
      "type": "switch",
      "x": 20,
      "y": 20,
      "label": "Scene run",
      "enabled": true,
      "params": {
        "value": 1
      }
    },
    {
      "id": "reset",
      "type": "switch",
      "x": 20,
      "y": 220,
      "label": "Reset feeder",
      "enabled": true,
      "params": {
        "value": 0
      }
    },
    {
      "id": "refill",
      "type": "switch",
      "x": 20,
      "y": 420,
      "label": "Refill hopper · pulse",
      "enabled": true,
      "params": {
        "value": 0
      }
    },
    {
      "id": "force",
