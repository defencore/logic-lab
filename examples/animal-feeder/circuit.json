        "bowlCapacity": 100,
        "initialHopper": 300,
        "initialLevel": 10,
        "dispenseRate": 25,
        "eatRate": 4,
        "hungryThreshold": 20,
        "fullThreshold": 60,
        "alarmThreshold": 90,
        "portionSize": 40
