{
  "version": 1,
  "name": "Greenhouse: climate and growth",
  "exampleId": "greenhouse-climate",
  "nodes": [
    {
      "id": "run",
      "type": "switch",
      "label": "Scene run",
      "x": 20,
      "y": 20,
      "enabled": true,
      "params": {
        "value": 1
      }
    },
    {
      "id": "reset",
      "type": "switch",
      "label": "Reset process",
      "x": 20,
      "y": 210,
      "enabled": true,
      "params": {
        "value": 0
      }
    },
    {
      "id": "world",
      "type": "greenhouse",
      "label": "Greenhouse climate controller",
      "x": 320,
      "y": 60,
      "enabled": true,
      "params": {
        "initialTemperature": 20,
        "ambientTemperature": 12,
        "initialMoisture": 45,
        "dayLength": 60
      }
    },
    {
      "id": "unsafe-heat",
      "type": "switch",
      "label": "Unsafe heater stuck on",
      "x": 20,
      "y": 400,
      "enabled": true,
      "params": {
        "value": 0
      }
    },
    {
      "id": "not-hot",
      "type": "not",
      "label": "Temperature below hot threshold",
      "x": 650,
      "y": 20,
      "enabled": true,
      "params": {}
    },
    {
      "id": "heat-safe",
      "type": "and",
      "label": "Cold AND not hot",
      "x": 650,
      "y": 225,
      "enabled": true,
      "params": {}
    },
    {
      "id": "heat",
      "type": "or",
      "label": "Climate request OR failed heater",
      "x": 650,
      "y": 430,
      "enabled": true,
      "params": {}
    },
    {
      "id": "no-fault",
      "type": "not",
      "label": "Ventilation available",
      "x": 650,
      "y": 635,
      "enabled": true,
      "params": {}
    },
    {
      "id": "vent",
      "type": "and",
      "label": "Hot AND ventilation available",
      "x": 940,
      "y": 20,
      "enabled": true,
      "params": {}
    },
    {
      "id": "alarm",
      "type": "led",
      "label": "Process alarm",
      "x": 1800,
      "y": 120,
      "enabled": true,
      "params": {}
    }
  ],
  "wires": [
    {
      "id": "run-out-world-run",
      "from": {
        "node": "run",
        "port": "out"
      },
      "to": {
        "node": "world",
        "port": "run"
      },
      "width": 1
    },
    {
      "id": "reset-out-world-reset",
      "from": {
        "node": "reset",
        "port": "out"
      },
      "to": {
        "node": "world",
        "port": "reset"
      },
      "width": 1
    },
    {
      "id": "world-dry-world-pump",
      "from": {
        "node": "world",
        "port": "dry"
      },
      "to": {
        "node": "world",
        "port": "pump"
      },
      "width": 1
    },
    {
      "id": "world-dark-world-grow_light",
      "from": {
        "node": "world",
        "port": "dark"
      },
      "to": {
        "node": "world",
        "port": "grow_light"
      },
      "width": 1
    },
    {
      "id": "world-hot-not-hot-a",
      "from": {
        "node": "world",
        "port": "hot"
      },
      "to": {
        "node": "not-hot",
        "port": "a"
      },
      "width": 1
    },
    {
      "id": "world-cold-heat-safe-a",
      "from": {
        "node": "world",
        "port": "cold"
      },
      "to": {
        "node": "heat-safe",
        "port": "a"
      },
      "width": 1
    },
    {
      "id": "not-hot-out-heat-safe-b",
      "from": {
        "node": "not-hot",
        "port": "out"
      },
      "to": {
        "node": "heat-safe",
        "port": "b"
      },
      "width": 1
    },
    {
      "id": "heat-safe-out-heat-a",
      "from": {
        "node": "heat-safe",
        "port": "out"
      },
      "to": {
        "node": "heat",
        "port": "a"
      },
      "width": 1
    },
    {
      "id": "unsafe-heat-out-heat-b",
      "from": {
        "node": "unsafe-heat",
        "port": "out"
      },
      "to": {
        "node": "heat",
        "port": "b"
      },
      "width": 1
    },
    {
      "id": "heat-out-world-heater",
      "from": {
        "node": "heat",
        "port": "out"
      },
      "to": {
        "node": "world",
        "port": "heater"
      },
      "width": 1
    },
    {
      "id": "unsafe-heat-out-no-fault-a",
      "from": {
        "node": "unsafe-heat",
        "port": "out"
      },
      "to": {
        "node": "no-fault",
        "port": "a"
      },
      "width": 1
    },
    {
      "id": "world-hot-vent-a",
      "from": {
        "node": "world",
        "port": "hot"
      },
      "to": {
        "node": "vent",
        "port": "a"
      },
      "width": 1
    },
    {
      "id": "no-fault-out-vent-b",
      "from": {
        "node": "no-fault",
        "port": "out"
      },
      "to": {
        "node": "vent",
        "port": "b"
      },
      "width": 1
    },
    {
      "id": "vent-out-world-vent",
      "from": {
        "node": "vent",
        "port": "out"
      },
      "to": {
        "node": "world",
        "port": "vent"
      },
      "width": 1
    },
    {
      "id": "world-alarm-alarm-in",
      "from": {
        "node": "world",
        "port": "alarm"
      },
      "to": {
        "node": "alarm",
        "port": "in"
      },
      "width": 1
    }
  ]
}
