{
  "version": 1,
  "name": "Three-axis printer motion",
  "exampleId": "printer-xyz",
  "nodes": [
    {
      "id": "x-axis",
      "type": "stepper",
      "x": 440,
      "y": 80,
      "label": "X axis",
      "enabled": true,
      "params": {
        "stepsPerRevolution": 200,
        "microsteps": 1,
        "lead": 8,
        "initial": 5,
        "min": 0,
        "max": 20
      }
    },
    {
      "id": "y-axis",
      "type": "stepper",
      "x": 440,
      "y": 380,
      "label": "Y axis",
      "enabled": true,
      "params": {
        "stepsPerRevolution": 200,
        "microsteps": 1,
        "lead": 8,
        "initial": 10,
        "min": 0,
        "max": 20
      }
    },
    {
      "id": "z-axis",
      "type": "stepper",
      "x": 440,
      "y": 680,
      "label": "Z axis",
      "enabled": true,
      "params": {
        "stepsPerRevolution": 200,
        "microsteps": 1,
        "lead": 2,
        "initial": 3,
        "min": 0,
        "max": 20
      }
    },
    {
      "id": "clock",
      "type": "clock",
      "x": 40,
      "y": 40,
      "label": "Shared step clock · 40 Hz",
      "enabled": true,
      "params": {
        "frequency": 40,
        "duty": 0.5
      }
    },
    {
      "id": "x-direction",
      "type": "switch",
      "x": 40,
      "y": 180,
      "label": "X direction · 1 = positive",
      "enabled": true,
      "params": {
        "value": 1
      }
    },
    {
      "id": "x-enable",
      "type": "switch",
      "x": 240,
      "y": 180,
      "label": "X enable",
      "enabled": true,
      "params": {
        "value": 1
      }
    },
    {
      "id": "x-min",
      "type": "limit_switch",
      "x": 760,
      "y": 80,
      "label": "X min endstop",
      "enabled": true,
      "params": {
        "threshold": 0,
        "mode": "below",
        "normallyClosed": false
      }
    },
    {
      "id": "x-min-led",
      "type": "led",
      "x": 1040,
      "y": 80,
      "label": "X min reached",
      "enabled": true,
      "params": {}
    },
    {
      "id": "x-max",
      "type": "limit_switch",
      "x": 760,
      "y": 220,
      "label": "X max endstop",
      "enabled": true,
      "params": {
        "threshold": 20,
        "mode": "above",
        "normallyClosed": false
