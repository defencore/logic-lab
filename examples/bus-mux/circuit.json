      "x": 600,
      "y": 180,
      "label": "Split byte",
      "enabled": true,
      "params": {}
    },
    {
      "id": "merger",
      "type": "merger",
      "x": 880,
      "y": 180,
      "label": "Merge the same bits",
      "enabled": true,
      "params": {}
    },
    {
      "id": "demux",
      "type": "demux",
      "x": 1160,
      "y": 240,
      "label": "Route selected byte",
      "enabled": true,
      "params": {}
    },
    {
      "id": "left",
      "type": "scope",
      "x": 1440,
      "y": 80,
      "label": "Route 0 · byte",
      "enabled": true,
      "params": {
        "range": 255
      }
    },
    {
      "id": "right",
      "type": "scope",
      "x": 1440,
      "y": 400,
      "label": "Route 1 · byte",
      "enabled": true,
      "params": {
        "range": 255
      }
    }
  ],
