{
  "version": 1,
  "name": "Bus routing and selection",
  "nodes": [
    {
      "id": "a",
      "type": "bus_input",
      "x": 40,
      "y": 40,
      "label": "Byte A",
      "enabled": true,
      "params": {
        "value": 42
      }
    },
    {
      "id": "b",
      "type": "bus_input",
      "x": 40,
      "y": 260,
      "label": "Byte B",
      "enabled": true,
      "params": {
        "value": 165
      }
    },
    {
      "id": "select",
      "type": "switch",
      "x": 40,
      "y": 480,
      "label": "Select B",
      "enabled": true,
      "params": {
        "value": 0
      }
    },
    {
      "id": "mux",
      "type": "mux",
      "x": 320,
      "y": 240,
      "label": "Choose A or B",
      "enabled": true,
      "params": {}
    },
    {
      "id": "splitter",
