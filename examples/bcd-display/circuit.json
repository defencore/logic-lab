{
  "version": 1,
  "name": "BCD display decoder",
  "nodes": [
    {
      "id": "digit",
      "type": "bus_input",
      "x": 100,
      "y": 220,
      "label": "Digit · value 0–9",
      "enabled": true,
      "params": {
        "value": 5
      }
    },
    {
      "id": "decoder",
      "type": "decoder",
      "x": 500,
      "y": 220,
      "label": "BCD → seven segments",
      "enabled": true,
      "params": {}
    },
    {
      "id": "display",
      "type": "sevenseg",
      "x": 900,
      "y": 220,
      "label": "Decimal digit",
      "enabled": true,
      "params": {}
    }
  ],
