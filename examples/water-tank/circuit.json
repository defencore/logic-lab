{
  "version": 1,
  "name": "Tank level hysteresis",
  "exampleId": "water-tank",
  "nodes": [
    {
      "id": "run",
      "type": "switch",
      "x": 20,
      "y": 20,
      "label": "Scene run",
      "enabled": true,
      "params": {
        "value": 1
      }
    },
    {
      "id": "reset",
      "type": "switch",
      "x": 20,
      "y": 220,
      "label": "Reset tank",
      "enabled": true,
      "params": {
        "value": 0
      }
    },
    {
      "id": "drain",
      "type": "switch",
      "x": 20,
      "y": 420,
      "label": "Drain outlet",
      "enabled": true,
      "params": {
        "value": 1
      }
    },
    {
      "id": "force",
      "type": "switch",
      "x": 20,
      "y": 620,
      "label": "Force pump on",
      "enabled": true,
      "params": {
        "value": 0
      }
    },
    {
      "id": "tank",
      "type": "water_tank",
      "x": 320,
      "y": 230,
      "label": "Water tank",
      "enabled": true,
      "params": {
        "capacity": 100,
        "initialLevel": 35,
        "pumpRate": 12,
        "drainRate": 4,
        "lowThreshold": 20,
        "highThreshold": 80
      }
    },
    {
      "id": "not-reset",
      "type": "not",
      "x": 620,
      "y": 20,
      "label": "Reset inactive",
      "enabled": true,
      "params": {}
    },
    {
      "id": "start",
      "type": "and",
      "x": 890,
      "y": 20,
      "label": "Low AND not reset",
      "enabled": true,
      "params": {}
    },
    {
      "id": "stop",
      "type": "or",
      "x": 890,
      "y": 230,
      "label": "High OR reset",
      "enabled": true,
      "params": {}
    },
    {
      "id": "memory",
      "type": "sr_latch",
      "x": 1160,
      "y": 120,
      "label": "Pump hysteresis",
      "enabled": true,
      "params": {
        "initial": 0
      }
    },
    {
      "id": "pump",
      "type": "or",
      "x": 1430,
      "y": 230,
      "label": "Automatic OR forced pump",
      "enabled": true,
      "params": {}
    },
    {
      "id": "overflow",
      "type": "led",
      "x": 1710,
      "y": 230,
      "label": "Overflow latched",
      "enabled": true,
      "params": {}
    }
  ],
  "wires": [
    {
      "id": "run-out-tank-run",
      "from": {
        "node": "run",
        "port": "out"
      },
      "to": {
        "node": "tank",
        "port": "run"
      },
      "width": 1
    },
    {
      "id": "reset-out-tank-reset",
      "from": {
        "node": "reset",
        "port": "out"
      },
      "to": {
        "node": "tank",
        "port": "reset"
      },
      "width": 1
    },
    {
      "id": "drain-out-tank-drain",
      "from": {
        "node": "drain",
        "port": "out"
      },
      "to": {
        "node": "tank",
        "port": "drain"
      },
      "width": 1
    },
    {
      "id": "reset-out-not-reset-a",
      "from": {
        "node": "reset",
        "port": "out"
      },
      "to": {
        "node": "not-reset",
        "port": "a"
      },
      "width": 1
    },
    {
      "id": "tank-low-start-a",
      "from": {
        "node": "tank",
        "port": "low"
      },
      "to": {
        "node": "start",
        "port": "a"
      },
      "width": 1
    },
    {
      "id": "not-reset-out-start-b",
      "from": {
        "node": "not-reset",
        "port": "out"
      },
      "to": {
        "node": "start",
        "port": "b"
      },
      "width": 1
    },
    {
      "id": "tank-high-stop-a",
      "from": {
        "node": "tank",
        "port": "high"
      },
      "to": {
        "node": "stop",
        "port": "a"
      },
      "width": 1
    },
    {
      "id": "reset-out-stop-b",
      "from": {
        "node": "reset",
        "port": "out"
      },
      "to": {
        "node": "stop",
        "port": "b"
      },
      "width": 1
    },
    {
      "id": "start-out-memory-s",
      "from": {
        "node": "start",
        "port": "out"
      },
      "to": {
        "node": "memory",
        "port": "s"
      },
      "width": 1
    },
    {
      "id": "stop-out-memory-r",
      "from": {
        "node": "stop",
        "port": "out"
      },
      "to": {
        "node": "memory",
        "port": "r"
      },
      "width": 1
    },
    {
      "id": "memory-q-pump-a",
      "from": {
        "node": "memory",
        "port": "q"
      },
      "to": {
        "node": "pump",
        "port": "a"
      },
      "width": 1
    },
    {
      "id": "force-out-pump-b",
      "from": {
        "node": "force",
        "port": "out"
      },
      "to": {
        "node": "pump",
        "port": "b"
      },
      "width": 1
    },
    {
      "id": "pump-out-tank-pump",
      "from": {
        "node": "pump",
        "port": "out"
      },
      "to": {
        "node": "tank",
        "port": "pump"
      },
      "width": 1
    },
    {
      "id": "tank-overflow-overflow-in",
      "from": {
        "node": "tank",
        "port": "overflow"
      },
      "to": {
        "node": "overflow",
        "port": "in"
      },
      "width": 1
    }
  ]
}
