{
  "name": "logic-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A browser-native digital and mixed-signal logic workbench",
  "scripts": {
    "start": "node scripts/start.mjs",
    "test": "node scripts/test.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "format": "prettier --write \"src/**/*.{js,css}\" \"test/**/*.js\" \"examples/**/*.{js,json,md}\" \"scripts/*.mjs\" style.css index.html README.md package.json .github/workflows/pages.yml .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"test/**/*.js\" \"examples/**/*.{js,json,md}\" \"scripts/*.mjs\" style.css index.html README.md package.json .github/workflows/pages.yml .prettierrc.json"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "prettier": "3.6.2"
  },
  "dependencies": {
    "three": "0.187.0"
  }
}
