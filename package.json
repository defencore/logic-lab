{
  "name": "logic-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A browser-native digital and mixed-signal logic workbench",
  "scripts": {
    "start": "python3 -m http.server 4173 --bind 127.0.0.1",
    "test": "node --test test/*.test.js",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\" \"scripts/*.mjs\" style.css index.html README.md package.json .github/workflows/pages.yml .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.js\" \"test/**/*.js\" \"scripts/*.mjs\" style.css index.html README.md package.json .github/workflows/pages.yml .prettierrc.json"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
